# Raptor blocks, appended to /etc/caddy/Caddyfile on the droplet.
# sslip.io hostnames resolve to the IP embedded in them, so they need no DNS
# setup and still get automatic HTTPS.

raptor-api.159-89-169-228.sslip.io {
	encode gzip
	reverse_proxy 127.0.0.1:3100
}

# Deliberately insecure demo target (fake keys). See /demo.
raptor-demo.159-89-169-228.sslip.io {
	root * /var/www/raptor-demo
	file_server
	header Cache-Control "no-store"
	header X-Robots-Tag "noindex"
}
